rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    /* Shared by create and update so an author cannot sidestep the size
       limits by editing a document that was created under them. */
    function validTool() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 2
        && request.resource.data.name.size() < 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 5
        && request.resource.data.description.size() < 500
        && request.resource.data.code is string
        && request.resource.data.code.size() > 10
        && request.resource.data.code.size() < 100000;
    }

    match /communityTools/{toolId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && validTool();

      /* An author may edit their own tool, but the same field limits apply.
         `hidden` and `featured` stay admin-only: without that, an author could
         un-hide a tool auto-hidden by moderation. */
      allow update: if (
        isAuthor() || isAdmin()
      ) && validTool()
        && (!isAuthor() || isAdmin() || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'featured'])
        ))
        || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['runs', 'updatedAt'])
          && request.resource.data.runs == resource.data.runs + 1
        );

      allow delete: if isAuthor() || isAdmin();
    }

    match /communityToolRatings/{ratingId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.toolId is string
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /communityToolReports/{reportId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.toolId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 1
        && request.resource.data.reason.size() < 120;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
