# ── PSDKIT Pro — environment variables (copy to .env for local dev) ──
# On Vercel: Settings → Environment Variables (same names).

# Firebase — Google sign-in + Community Toolbox database (optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI assistant — server-side only (never exposed to the browser)
# Use OPENAI_API_KEY or GEMINI_API_KEY (or both; OpenAI is tried first)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini
